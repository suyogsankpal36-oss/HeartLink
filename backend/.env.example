# ==============================================================================
# HEARTLINK BACKEND — PRODUCTION & LOCAL ENVIRONMENT VARIABLES (.env.example)
# Do NOT place real secrets in this template or commit real .env files to Git.
# ==============================================================================

# Server Environment & Port (Assigned dynamically by Render or set manually)
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection URI from Atlas > Connect > Drivers.
# Paste the URI into backend/.env; do not commit credentials.
MONGODB_URI=

# Firebase Authentication project used to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=
# Optional Google OAuth web client ID, only for direct Google OAuth ID tokens.
GOOGLE_OAUTH_CLIENT_ID=

# Generate independent random values with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ACCESS_TOKEN_SECRET (or JWT_SECRET) and REFRESH_TOKEN_SECRET (or JWT_REFRESH_SECRET)
ACCESS_TOKEN_SECRET=replace_with_a_random_secret_of_at_least_32_characters
REFRESH_TOKEN_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
# Aliases accepted:
# JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Use "none" with HTTPS when frontend and API are hosted on different sites.
# The refresh cookie is HTTP-only, Secure in production, and scoped to path / so
# all supported auth aliases can refresh it. Leave COOKIE_DOMAIN unset for a
# Render hostname; set it only for an owned custom API domain when required.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=api.example.com

# Frontend Origins for CORS & Socket.IO Security
# Set this to your frontend origin in each environment. Production must use HTTPS.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional legacy Cloudinary credentials for deleting photos hosted before GridFS storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP for password recovery. Set all fields to enable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server-owned display prices (minor currency units; e.g. 49900 = ₹499.00 when currency is INR)
SUBSCRIPTION_CURRENCY=INR
PLAN_MONTHLY_AMOUNT_MINOR=49900
PLAN_QUARTERLY_AMOUNT_MINOR=119700
PLAN_ANNUAL_AMOUNT_MINOR=358800
# Payment checkout remains disabled until a provider and verified webhook integration are implemented.

# Super Admin One-Time Bootstrap (Run: npm run bootstrap:admin)
# Define these to create your initial super administrator account, then remove password for security.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
